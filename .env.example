# Kopieer naar backend/.env en vul in. Zet dit bestand nooit met echte waarden in git.
DATABASE_URL=postgresql+psycopg://portefeuille:portefeuille@localhost:5432/portefeuille
# Genereer met: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_GEHEIM=
# Genereer met: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Bewaar deze sleutel veilig en apart van de database; zonder sleutel zijn klantgegevens onleesbaar.
VERSLEUTELSLEUTEL=
